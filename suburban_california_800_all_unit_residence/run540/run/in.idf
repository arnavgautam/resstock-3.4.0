Schedule:File,
  hot_water_clothes_washer,               !- Name
  Fractional,                             !- Schedule Type Limits Name
  in.schedules.csv,                       !- File Name
  12,                                     !- Column Number
  1,                                      !- Rows to Skip at Top
  8760,                                   !- Number of Hours of Data
  Comma,                                  !- Column Separator
  No,                                     !- Interpolate to Timestep
  60,                                     !- Minutes per Item
  Yes;                                    !- Adjust Schedule for Daylight Savings

Schedule:File,
  hot_water_fixtures,                     !- Name
  Fractional,                             !- Schedule Type Limits Name
  in.schedules.csv,                       !- File Name
  13,                                     !- Column Number
  1,                                      !- Rows to Skip at Top
  8760,                                   !- Number of Hours of Data
  Comma,                                  !- Column Separator
  No,                                     !- Interpolate to Timestep
  60,                                     !- Minutes per Item
  Yes;                                    !- Adjust Schedule for Daylight Savings

OutdoorAir:Node,
  Model Outdoor Air Node;                 !- Name

PlantLoop,
  boiler hydronic heat loop,              !- Name
  Water,                                  !- Fluid Type
  ,                                       !- User Defined Fluid Type
  boiler hydronic heat loop Operation Schemes, !- Plant Equipment Operation Scheme Name
  Node 3,                                 !- Loop Temperature Setpoint Node Name
  100,                                    !- Maximum Loop Temperature {C}
  0,                                      !- Minimum Loop Temperature {C}
  Autosize,                               !- Maximum Loop Flow Rate {m3/s}
  0,                                      !- Minimum Loop Flow Rate {m3/s}
  Autocalculate,                          !- Plant Loop Volume {m3}
  Node 2,                                 !- Plant Side Inlet Node Name
  Node 3,                                 !- Plant Side Outlet Node Name
  boiler hydronic heat loop Supply Branches, !- Plant Side Branch List Name
  boiler hydronic heat loop Supply Connector List, !- Plant Side Connector List Name
  Node 5,                                 !- Demand Side Inlet Node Name
  Node 6,                                 !- Demand Side Outlet Node Name
  boiler hydronic heat loop Demand Branches, !- Demand Side Branch List Name
  boiler hydronic heat loop Demand Connector List, !- Demand Side Connector List Name
  Optimal,                                !- Load Distribution Scheme
  ,                                       !- Availability Manager List Name
  SingleSetpoint,                         !- Plant Loop Demand Calculation Scheme
  None;                                   !- Common Pipe Simulation

Sizing:Plant,
  boiler hydronic heat loop,              !- Plant or Condenser Loop Name
  Heating,                                !- Loop Type
  82.2222222222222,                       !- Design Loop Exit Temperature {C}
  11.1111111111111,                       !- Loop Design Temperature Difference {deltaC}
  NonCoincident,                          !- Sizing Option
  1,                                      !- Zone Timesteps in Averaging Window
  None;                                   !- Coincident Sizing Factor Mode

BranchList,
  boiler hydronic heat loop Supply Branches, !- Name
  boiler hydronic heat loop Supply Inlet Branch, !- Branch Name 1
  boiler hydronic heat loop Supply Branch 1, !- Branch Name 2
  boiler hydronic heat loop Supply Branch 2, !- Branch Name 3
  boiler hydronic heat loop Supply Outlet Branch; !- Branch Name 4

ConnectorList,
  boiler hydronic heat loop Supply Connector List, !- Name
  Connector:Splitter,                     !- Connector Object Type 1
  boiler hydronic heat loop Supply Splitter, !- Connector Name 1
  Connector:Mixer,                        !- Connector Object Type 2
  boiler hydronic heat loop Supply Mixer; !- Connector Name 2

Connector:Splitter,
  boiler hydronic heat loop Supply Splitter, !- Name
  boiler hydronic heat loop Supply Inlet Branch, !- Inlet Branch Name
  boiler hydronic heat loop Supply Branch 1, !- Outlet Branch Name 1
  boiler hydronic heat loop Supply Branch 2; !- Outlet Branch Name 2

Connector:Mixer,
  boiler hydronic heat loop Supply Mixer, !- Name
  boiler hydronic heat loop Supply Outlet Branch, !- Outlet Branch Name
  boiler hydronic heat loop Supply Branch 1, !- Inlet Branch Name 1
  boiler hydronic heat loop Supply Branch 2; !- Inlet Branch Name 2

Branch,
  boiler hydronic heat loop Supply Inlet Branch, !- Name
  ,                                       !- Pressure Drop Curve Name
  Pump:VariableSpeed,                     !- Component Object Type 1
  boiler hydronic pump,                   !- Component Name 1
